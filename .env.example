# Database configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/drone_ai

# Security & Authentication
JWT_SECRET=super-secret-drone-navigation-ai-jwt-key-2026

# Camera & RTSP Streaming (PRD Section 26)
RTSP_URL=rtsp://192.168.144.108:554/stream=1

# Tri AI Models Configuration (PRD Section 5, 6, 7, 25, 26)
NAVIGATION_MODEL_PATH=ml_engine/models/navigation_best.pt
FOD_MODEL_PATH=ml_engine/models/FOD_Karhtikeyan.pt
RUNWAY_LIGHT_MODEL_PATH=ml_engine/models/runway_light_best.pt
MODELS_CONFIG_PATH=ml_engine/configs/models.yaml

# Thresholds & Detection Parameters (PRD Section 26)
NAVIGATION_CONFIDENCE=0.25
FOD_CONFIDENCE=0.18
RUNWAY_LIGHT_CONFIDENCE=0.25
IOU_THRESHOLD=0.45

# Runway Light Scan Window Pipeline Settings (PRD Section 9, 10, 11, 16, 18, 20, 26)
RUNWAY_SCAN_START=0.52
RUNWAY_SCAN_HEIGHT=0.20
RUNWAY_TILE_SIZE=640
RUNWAY_TILE_STRIDE=480
RUNWAY_DETECT_STRIDE=10
RUNWAY_PREPROCESS=auto
RUNWAY_TRACKING=true
RUNWAY_REFINE_BOXES=true
RUNWAY_INFER_MISSING_OFF=false

# Full-Frame & Tiled Inference Settings
USE_TILED_INFERENCE=true
TILE_SIZE=640
TILE_OVERLAP=0.25
USE_FULL_FRAME_PASS=true

# Temporal Confirmation Settings (PRD Section 33)
LIGHT_FAULT_CONFIRM_FRAMES=5

# Backend Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
